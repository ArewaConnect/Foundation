rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function superAdmin(){return signedIn()&&request.auth.token.superAdmin==true;}
  function founder(){return signedIn()&&request.auth.token.role=="Founder";}
  function hasPage(p){return signedIn()&&p in request.auth.token.permissions;}
  match /userAccounts/{uid}{allow read:if superAdmin();allow write:false;}
  match /usernames/{name}{allow read,write:false;}
  match /members/{id}{
   allow create:if signedIn()&&hasPage("registration");
   allow read:if superAdmin()||(founder()&&hasPage("members-record"));
   allow update,delete:if superAdmin();
  }
  match /{document=**}{allow read,write:false;}
 }
}